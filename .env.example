# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/galabau

# ============================================
# SERVER
# ============================================
PORT=3001
NODE_ENV=development

# ============================================
# WORKER RECRUITMENT AUTOMATION
# ============================================
# Enable/Disable the automation system
ENABLE_AUTOMATION=true
AUTOMATION_DEBUG=false

# Scraping configuration
SCRAPING_REGIONS=berlin,brandenburg
DAILY_SCRAPE_LIMIT=100

# Message sending configuration
DAILY_MESSAGE_LIMIT=50
MESSAGE_RETRY_MAX=3
MESSAGE_RETRY_HOURS=1

# ============================================
# MESSAGING SERVICES
# ============================================

# Twilio (SMS + WhatsApp)
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=your_token
TWILIO_PHONE_NUMBER=+49xxx
TWILIO_WHATSAPP_NUMBER=+49xxx

# SendGrid (Email)
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=noreply@kania-galabau.de

# ============================================
# REDIS (Message Queue)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================
# AI & APIS
# ============================================

# Claude AI (for message generation & qualification)
ANTHROPIC_API_KEY=sk-ant-xxx

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ============================================
# STORAGE
# ============================================
AWS_S3_BUCKET=galabau-quotes
AWS_REGION=eu-central-1
